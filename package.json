{
  "name": "diary-xp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "size": "node scripts/measure-size.mjs",
    "assets": "node scripts/optimize-assets.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-diary-xp \"node --test scripts/tests\""
  },
  "dependencies": {
    "@preact/signals": "^1.3.4",
    "firebase": "^10.14.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@preact/preset-vite": "^2.10.6",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.35.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
