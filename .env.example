# ---------------------------------------------------------------------------
# Public Firebase web config. Vite inlines every VITE_ variable into the client
# bundle, so these values are safe to expose only because the security rules
# are what actually protect the data.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Server-side only. No VITE_ prefix means these are never shipped to the browser
# and are read by scripts/set-admin.mjs alone.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
SERVICE_ACCOUNT_KEY=firebase/serviceAccountKey.json
