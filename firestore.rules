rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin is a custom claim minted by scripts/set-admin.mjs. The client can only
    // read it from a cryptographically signed ID token, so this cannot be forged.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isDateId(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A well-formed entry: doc id is the date, no unexpected fields, bounded text,
    // string URLs/paths and real timestamps.
    function isValidEntry(id, data) {
      let allowed = ['date', 'title', 'content', 'imageUrl', 'thumbUrl', 'imagePath', 'thumbPath', 'createdAt', 'updatedAt'];
      return isDateId(id)
        && data.keys().hasAll(allowed)
        && data.keys().hasOnly(allowed)
        && data.date == id
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.content is string
        && data.content.size() <= 20000
        && data.imageUrl is string
        && data.thumbUrl is string
        && data.imagePath is string
        && data.thumbPath is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /entries/{date} {
      allow read: if signedIn();
      allow create: if isAdmin() && isValidEntry(date, request.resource.data);
      allow update: if isAdmin()
        && isValidEntry(date, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // Nothing else in the database is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
